# Database. Local default is a SQLite file; use a Turso/libSQL URL in production.
DATABASE_URL=file:./data/blog.db
# DATABASE_URL=libsql://your-db-your-org.turso.io
DATABASE_AUTH_TOKEN=

# Write access to the API: send "Authorization: Bearer <ADMIN_API_KEY>"
ADMIN_API_KEY=change-me-long-random-string
# Password for the /admin login (sets a signed httpOnly session cookie)
ADMIN_PASSWORD=change-me
# 32+ random chars used to HMAC-sign the session cookie
SESSION_SECRET=change-me-32-plus-random-characters

# Public origin, used for canonical URLs, RSS, sitemap and JSON-LD
NEXT_PUBLIC_SITE_URL=http://localhost:3000
